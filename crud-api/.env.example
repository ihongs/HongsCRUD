# ---------- 基础服务 ----------
MONGO_URI=mongodb://localhost:27017/crud
PORT=3000

# ---------- 认证 & 鉴权 ----------
# JWT 签名密钥 (必填，生产环境务必使用强随机值)
JWT_SECRET=please-change-me-to-a-strong-random-secret

# Access Token 有效期 (毫秒)，默认 15 分钟
ACCESS_TTL=900000

# Refresh Token 有效期 (毫秒)，默认 365 天 (1 年)
REFRESH_TTL=31536000000

# PoW Challenge 有效期 (毫秒)，默认 2 分钟
CHALLENGE_TTL=120000

# PoW 难度 (2 的 N 次方运算次数)，默认 16 (即 65536 次)
CHALLENGE_DIF=16

# ---------- 上传 ----------
# 本地上传存储目录 (相对运行目录)，默认 ./static/upload（由静态服务对外提供访问）
UPLOAD_DIR=./static/upload

# 上传临时文件目录 (相对运行目录)，默认 ./server/tmp，建议放到与存储同盘目录便于清理
# UPLOAD_TMP=./server/tmp

# 允许的上传场景 (子目录，逗号分隔)，默认 common,avatar；第一个为未指定 scene 时的默认值
UPLOAD_SCENES=common,avatar

# 上传驱动模块：取其默认导出为驱动类（无参构造，自行读环境变量配置，惯例同 KV_ROSTER）
# 未配置时用内置本地驱动；云存储时写驱动模块路径，'./' 开头相对运行目录，其余按包名
# UPLOAD_DRIVER=./src/utils/upload/drivers/local
# UPLOAD_DRIVER=./src/utils/upload/drivers/s3    # Amazon S3 及 COS/TOS/MinIO 等 S3 兼容存储
# UPLOAD_DRIVER=./src/utils/upload/drivers/oss   # 阿里云 OSS

# --- S3 驱动配置（直传，预签名 PUT）---
# S3_BUCKET=my-bucket
# S3_REGION=ap-northeast-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_ENDPOINT=              # S3 兼容存储填其 S3 协议 endpoint，如 https://cos.ap-beijing.myqcloud.com
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=       # 访问域名（CDN/公有读），不填按 endpoint 推导

# --- OSS 驱动配置（直传，预签名 PUT）---
# OSS_BUCKET=
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_STS_TOKEN=
# OSS_ENDPOINT=             # 如 oss-cn-hangzhou.aliyuncs.com 或自定义域名
# OSS_CNAME=false           # OSS_ENDPOINT 是绑定 Bucket 的自定义域名时设为 true
# OSS_SECURE=true
# OSS_PUBLIC_BASE_URL=      # 访问域名（CDN/自定义域名）

# 每 IP 每小时上传次数上限，默认 100
UPLOAD_RATE_LIMIT=100

# ---------- SSE ----------
# SSE 连接许可（getSSEUrl）有效期由调用方 ttl 决定：-1 不限，0 或不传用 ACCESS_TTL，>0 指定

# KV 存储 (上传限流用)，值为模块名，取其默认导出为实现类
KV_ROSTER=hongs-crud/kv/mongo
# MongoRoster 存储集合名，默认 rosters
# KV_ROSTER_COLLECTION=rosters

# ---------- 未来扩展 (预留占位) ----------
# roles 缓存策略 (内存 or redis)，默认内存
# ROLES_CACHE_DRIVER=memory
# roles 缓存 TTL (毫秒)，默认 5 分钟
# ROLES_CACHE_TTL=300000
