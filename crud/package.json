{
  "name": "hongs-crud",
  "version": "0.2.1",
  "description": "Hong's CRUD library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./es": {
      "types": "./dist/es/index.d.ts",
      "default": "./dist/es/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "es": [
        "dist/es/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test:crud": "tsc -p tsconfig.test.json && node dist-test/test/crud.js",
    "test:es": "tsc -p tsconfig.test.json && node dist-test/test/es.js"
  },
  "peerDependencies": {
    "mongoose": "^7.0.0 || ^8.0.0",
    "@elastic/elasticsearch": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@elastic/elasticsearch": {
      "optional": true
    }
  },
  "devDependencies": {
    "mongoose": "^8.0.0",
    "@elastic/elasticsearch": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "license": "MIT"
}
